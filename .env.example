# ---------------------------------------------------------------------------
# Base de datos (Postgres). En EasyPanel: creá un servicio Postgres y copiá su
# connection string interna acá. En local: coincide con docker-compose.yml.
# ---------------------------------------------------------------------------
POSTGRES_USER=clinica
POSTGRES_PASSWORD=clinica
POSTGRES_DB=sistema_clinica
DATABASE_URL=postgresql://clinica:clinica@localhost:5432/sistema_clinica

# ---------------------------------------------------------------------------
# YCloud (proveedor de WhatsApp Business API) - https://www.ycloud.com
# API Key:        Dashboard YCloud > Developers > API Key
# Webhook secret: Dashboard YCloud > Developers > Webhooks > tu endpoint
# Número de WhatsApp Business en formato E.164, ej: +595981234567
# ---------------------------------------------------------------------------
YCLOUD_API_KEY=tu_api_key_de_ycloud
YCLOUD_WEBHOOK_SECRET=tu_webhook_secret_de_ycloud
WHATSAPP_BUSINESS_NUMBER=+595900000000

# ---------------------------------------------------------------------------
# LLM (OpenRouter) - https://openrouter.ai
# El bot usa esto para entender lenguaje natural y agendar los turnos.
# API Key: openrouter.ai/keys
# Modelo:  cualquier modelo de OpenRouter que soporte "tool calling"/function
#          calling. Por defecto usamos uno barato (openai/gpt-4o-mini).
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=tu_api_key_de_openrouter
OPENROUTER_MODEL=openai/gpt-4o-mini
# Modelo de transcripción para notas de voz de WhatsApp (endpoint
# /api/v1/audio/transcriptions de OpenRouter). Whisper es barato y estable.
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo

# ---------------------------------------------------------------------------
# Configuración del bot
# REMINDER_HOURS_BEFORE / REMINDER_CUTOFF_MINUTES: recordatorio de turno.
# FOLLOWUP_DELAY_MINUTES: espera antes de mandar el seguimiento automático a
# un paciente que preguntó y no volvió a responder (ventana de 24h de
# WhatsApp). En producción dejalo como está (~23h); para grabar una demo en
# vivo podés bajarlo a minutos y volver a subirlo después.
# ---------------------------------------------------------------------------
PORT=3001
TZ=America/Asuncion
REMINDER_HOURS_BEFORE=24
REMINDER_CUTOFF_MINUTES=120
FOLLOWUP_DELAY_MINUTES=1380

# ---------------------------------------------------------------------------
# Panel (Next.js + NextAuth)
# NEXTAUTH_SECRET: generar con `openssl rand -base64 32`
# NEXTAUTH_URL: la URL pública del panel (en EasyPanel, el dominio que te asignen)
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=generar_un_secreto_aleatorio
NEXTAUTH_URL=http://localhost:3000
